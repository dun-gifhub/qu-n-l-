# ===================================================
# DeviceMonitor Environment Configuration
# ===================================================

# Neon PostgreSQL Database Connection URL
# Get this from your Neon Console (https://console.neon.tech):
# e.g.: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secret key for signing JSON Web Tokens (min 32 characters in production)
JWT_SECRET="dev_secret_key_change_me_in_production_super_safe_and_long_jwt"

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=3000

# Environment Mode
NODE_ENV="development"

# Client URL (for CORS and redirects)
CLIENT_URL="http://localhost:3000"
